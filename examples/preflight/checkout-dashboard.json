{
  "title": "Checkout API",
  "uid": "checkout-api",
  "panels": [
    {"id": 1, "title": "p95 latency by route", "type": "timeseries",
     "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_duration_bucket[5m])))"}]},
    {"id": 2, "title": "Orders per minute", "type": "stat",
     "targets": [{"refId": "A", "expr": "sum(rate(checkout_orders[5m])) * 60"}]},
    {"id": 3, "title": "Payment responses by status", "type": "timeseries",
     "targets": [{"refId": "A", "expr": "sum by (status_code) (rate(http_client_requests_total{peer=\"payments\"}[5m]))"}]},
    {"id": 4, "title": "Outbound requests by peer", "type": "timeseries",
     "targets": [{"refId": "A", "expr": "sum by (peer) (rate(http_client_requests_total[5m]))"}]},
    {"id": 5, "title": "GC pause p99", "type": "stat",
     "targets": [{"refId": "A", "expr": "max(runtime_gc_pause_seconds{quantile=\"0.99\"})"}]},
    {"id": 6, "title": "Worker job starts", "type": "timeseries",
     "targets": [{"refId": "A", "expr": "sum(rate(worker_jobs_active[5m]))"}]},
    {"id": 7, "title": "Inventory RPCs by method", "type": "timeseries",
     "targets": [{"refId": "A", "expr": "sum by (rpc_method) (rate(rpc_client_calls_total{rpc_service=\"inventory.v1.Stock\"}[5m]))"}]},
    {"id": 8, "title": "Resident memory", "type": "timeseries",
     "targets": [{"refId": "A", "expr": "process_resident_memory_bytes"}]}
  ]
}
